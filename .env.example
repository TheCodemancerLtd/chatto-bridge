# Discord
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Chatto ConnectRPC (Discord -> Chatto direction)
CHATTO_BASE_URL=https://chat.chatto.run
CHATTO_LOGIN=
CHATTO_PASSWORD=

# NATS (Chatto -> Discord direction)
# Matches CHATTO_NATS_CLIENT_URL on the Chatto server side.
NATS_URL=nats://localhost:4222
# Matches CHATTO_NATS_EMBEDDED_AUTH_TOKEN if the embedded NATS is used.
NATS_AUTH_TOKEN=

# Room <-> channel mapping as a JSON object.
# Keys are Chatto room IDs (ULID strings), values are Discord channel IDs.
BRIDGE_MAP={}

# Optional: logging level
LOG_LEVEL=INFO
